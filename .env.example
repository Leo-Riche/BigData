# --- Supabase (PostgreSQL) -------------------------------------------------
# Dashboard Supabase > bouton "Connect" > Session pooler (port 5432).
# L'utilisateur est de la forme postgres.<ref-du-projet>.
# Encoder les caracteres speciaux du mot de passe (@ -> %40, # -> %23, % -> %25).
DATABASE_URL=postgresql://postgres.<ref>:<mot-de-passe>@<host>.pooler.supabase.com:5432/postgres

# Optionnel : certificat telecharge depuis Settings > Database > SSL Configuration.
# Sans lui, la connexion est chiffree mais le certificat serveur n'est pas verifie.
# SUPABASE_CA_CERT=C:\chemin\vers\prod-ca-2021.crt

# Optionnel : PGSSL=disable pour un PostgreSQL local sans TLS (docker, dev).
# PGSSL=disable

# --- MySQL local -----------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=shop
